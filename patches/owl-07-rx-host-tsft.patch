diff --git i/src/rx.c w/src/rx.c
index 4581ae5..9b7f75b 100644
--- i/src/rx.c
+++ w/src/rx.c
@@ -487,9 +487,15 @@ int awdl_rx(const struct buf *frame, struct buf ***data_frame, struct awdl_state
 	uint64_t tsft;
 	uint8_t flags;
 
-	tsft = clock_time_us(); /* TODO Radiotap TSFT is more accurate but then need to access TSF in clock_time_us() */
-	if (radiotap_parse(frame, &rssi, &flags, NULL /* &tsft */) < 0)
+	tsft = 0;
+	if (radiotap_parse(frame, &rssi, &flags, &tsft) < 0)
 		return RX_UNEXPECTED_FORMAT;
+	/* A card's TSFT counts its own TSF, not clock_time_us(), so it's only used
+	 * when the radio says it's the host clock (-T): a radio behind a serial
+	 * link, where a frame can wait milliseconds before we see it, and the
+	 * reception time is what sync needs. */
+	if (!state->rx_tsft_host_clock || !tsft)
+		tsft = clock_time_us();
 	BUF_STRIP(frame, le16toh(((const struct ieee80211_radiotap_header *) buf_data(frame))->it_len));
 
 	if (check_fcs(frame, flags)) /* note that if no flags are present (flags==0), frames will pass */
