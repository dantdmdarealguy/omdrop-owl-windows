<Project Sdk="Microsoft.NET.Sdk">

  <!-- The AirDrop side of omdrop-owl-windows, shared by the CLI (omdrop), the
       service (OmdropService) and the tray app (OmdropTray): mDNS, the receiver
       and sender, plists, cpio and DVZip, the Bluetooth wake advert. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Omdrop</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- SignedCms, to check Apple's signature on a sender's record (Contacts Only). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.1" />
  </ItemGroup>

</Project>
