<Project Sdk="Microsoft.NET.Sdk">

  <!-- omdrop.exe: AirDrop from the command line (receive, send, ble, firewall),
       over awdl0, which owl.exe (windows/owl) brings up. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>omdrop</AssemblyName>
    <RootNamespace>Omdrop</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
    <!-- bin\Release\omdrop.exe, whatever the target framework: firewall rules name the path. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Omdrop.Core\Omdrop.Core.csproj" />
  </ItemGroup>

</Project>
